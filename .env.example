# ── Required ─────────────────────────────────────────────
# Postgres connection string. Local: `npm run db:init` creates this user, password and database on port 5433.
# On Render, use the database's Internal Database URL.
DATABASE_URL=postgres://skincare:CHOOSE_A_PASSWORD@127.0.0.1:5433/skincare
# Long random string; signs login cookies. Generate one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=change-me
# Public address of the site, no trailing slash (https://www.yourdomain.ch in production)
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
NEXT_PUBLIC_BRAND_NAME=Your Brand
# Keep false for the local database (it is kept in sync by `npm run dev`). Leave unset on Render.
RUN_MIGRATIONS_ON_START=false

# ── Stripe (TWINT, cards, Apple Pay, Google Pay) ─────────
# Test keys from https://dashboard.stripe.com/test/apikeys ; enable TWINT under Settings → Payment methods
STRIPE_SECRET_KEY=sk_test_
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_
STRIPE_WEBHOOKS_SIGNING_SECRET=whsec_

# ── Cloudinary (product photos uploaded in /admin) ───────
# Leave empty in development to store uploads in ./media on disk. Required on Render.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=store

# ── Email (order confirmations, password resets) ────────
# Leave SMTP_HOST empty to only log emails to the console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=orders@yourdomain.ch
STORE_NOTIFICATION_EMAIL=
